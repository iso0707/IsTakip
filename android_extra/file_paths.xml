<?xml version="1.0" encoding="utf-8"?>
<!--
    Makbuz PDF'lerinin bulunduğu klasörü (files/app/makbuzlar)
    FileProvider'a tanıtır. main.py -> MAKBUZ_KLASORU ile aynı
    yeri gösterir: uygulamanın kendi "files" dizini altındaki
    "app/makbuzlar" klasörü.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="makbuzlar" path="app/makbuzlar/"/>
</paths>
